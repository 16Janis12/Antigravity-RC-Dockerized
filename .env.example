# Antigravity Remote Control Daemon Configuration

# Custom instance name displayed in the Remote Control dashboard
AGY_INSTANCE_NAME=my-remote-docker

# Internal hub port (default: 4400)
AGY_HUB_PORT=4400

# Toggle rmyndharis/antigravity-skills community plugin (true/false)
ENABLE_COMMUNITY_SKILLS=true

# Additional plugins to auto-install (comma-separated URLs or git repos)
# AGY_PLUGINS=https://github.com/rmyndharis/antigravity-skills,https://github.com/sickn33/antigravity-awesome-skills
